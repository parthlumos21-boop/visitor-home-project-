{
  "name": "visitor-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "mobile"
  ],
  "scripts": {
    "start": "npm run start:mobile",
    "dev": "npm run dev:backend",
    "dev:all": "node tools/start-stack.js",
    "dev:backend": "npm --workspace=backend run dev",
    "start:mobile": "npm --workspace=mobile run start",
    "start:mobile:lan": "npm --workspace=mobile run start:lan",
    "start:mobile:go": "npm --workspace=mobile run start:go",
    "doctor:mobile-network": "npm --workspace=mobile run doctor:network",
    "doctor:mobile-network:fix": "npm --workspace=mobile run doctor:network:fix",
    "start:mobile:tunnel": "npm --workspace=mobile run start:tunnel -- -c",
    "start:mobile:clean": "npm --workspace=mobile run start -- -c",
    "start:mobile:ios": "npm --workspace=mobile run start:ios",
    "start:mobile:tablet": "npm --workspace=mobile run start:tablet",
    "start:mobile:offline": "npm --workspace=mobile run start:offline",
    "start:mobile:web": "npm --workspace=mobile run web:8082",
    "dev:frontend": "npm --workspace=frontend run dev"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
