  "scripts": {
    "start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo-8082.ps1",
    "start:lan": "npm start",
    "start:tunnel": "npm start -- --tunnel",
    "start:go": "npm start -- --go -c",
    "doctor:network": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/network-doctor.ps1",
    "doctor:network:fix": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/network-doctor.ps1 -FixFirewall",
    "fix:firewall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/fix-windows-firewall.ps1",
    "bundle:android": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/bundle-android.ps1",
    "build:dev": "eas build --profile development --platform android",
    "build:dev:local": "eas build --profile development --platform android --local",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas-build-post-install": "npm install lightningcss-linux-x64-gnu@1.27.0 --no-save"
  },
  "private": true
